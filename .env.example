# Copy to .env for local (host) runs. Inside Compose these are set by the
# compose file using service names instead of localhost.

S3_BUCKET=paperlm-papers
S3_ENDPOINT_URL=http://localhost:4566

REDIS_URL=redis://localhost:6379/0
GROBID_URL=http://localhost:8070

# LocalStack accepts any credentials, but boto3 still requires them to be set.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
